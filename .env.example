# test3 requires no credentials. These optional local settings cannot create charges.
TEST3_HOST=127.0.0.1
TEST3_PORT=8765
TEST3_MAX_UPLOAD_BYTES=52428800
TEST3_DATA_DIR=./data
# Explicitly set 1 only for the fictional well-known development account/data.
TEST3_DEMO_MODE=0
# Keep 0 for direct loopback HTTP. Set 1 only behind an explicitly configured local TLS endpoint.
TEST3_SECURE_COOKIE=0
# Optional path to a locally cloned/exported test1 data directory. No network lookup occurs.
TEST3_TEST1_DATA_DIR=
# Optional local-only Ollama endpoint. No hosted endpoint is accepted.
TEST3_OLLAMA_URL=http://127.0.0.1:11434

